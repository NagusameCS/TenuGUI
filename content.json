  "content": {
    "meta": {
      "title": "TenuGUI — Edit in place",
      "description": "A browser editor for any page. Edit in place, then export the changed HTML. No install or server."
    },
    "brand": {
      "name": "TenuGUI",
      "kanji": "手拭い",
      "descriptor": "Direct editing for static pages",
      "href": "#top"
    },
    "nav": [
